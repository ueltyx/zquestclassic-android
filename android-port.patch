diff --git 1/android/app/src/main/java/org/liballeg/android/PlayerActivity.java 2/android/app/src/main/java/org/liballeg/android/PlayerActivity.java
new file mode 100644
index 0000000..778f394
--- /dev/null
+++ 2/android/app/src/main/java/org/liballeg/android/PlayerActivity.java
@@ -0,0 +1,189 @@
+package org.liballeg.android;
+
+import android.graphics.Color;
+import android.graphics.drawable.GradientDrawable;
+import android.os.Bundle;
+import android.view.Gravity;
+import android.view.KeyEvent;
+import android.view.MotionEvent;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.FrameLayout;
+import android.widget.GridLayout;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+import android.util.Log;
+
+import java.util.HashMap;
+import java.util.Map;
+
+/** Allegro's Android surface with lightweight touch controls layered over it. */
+public final class PlayerActivity extends AllegroActivity {
+    private final Map<View, Integer> heldControls = new HashMap<>();
+    private View controlsOverlay;
+
+    static {
+        loadAllegroLibrary("allegro");
+        loadAllegroLibrary("allegro_primitives");
+        loadAllegroLibrary("allegro_image");
+        loadAllegroLibrary("allegro_font");
+        loadAllegroLibrary("allegro_audio");
+        loadAllegroLibrary("allegro_acodec");
+        loadAllegroLibrary("allegro_memfile");
+        loadAllegroLibrary("allegro_dialog");
+    }
+
+    private static void loadAllegroLibrary(String name) {
+        try {
+            System.loadLibrary(name + "-debug");
+        } catch (UnsatisfiedLinkError debugBuildNotFound) {
+            try {
+                System.loadLibrary(name);
+            } catch (UnsatisfiedLinkError releaseBuildNotFound) {
+                releaseBuildNotFound.addSuppressed(debugBuildNotFound);
+                Log.e("ZQuestClassic", "Could not load Allegro library " + name, releaseBuildNotFound);
+                throw releaseBuildNotFound;
+            }
+        }
+    }
+
+    public PlayerActivity() {
+        super("libzplayer.so");
+    }
+
+    @Override
+    public void onCreate(Bundle state) {
+        super.onCreate(state);
+        getWindow().getDecorView().setKeepScreenOn(true);
+    }
+
+    // Allegro creates/replaces its SurfaceView asynchronously after onCreate.
+    // This package-level override runs after that replacement, so the controls
+    // stay on top of the native game surface.
+    @Override
+    void createSurface() {
+        super.createSurface();
+        addTouchControls();
+    }
+
+    private void addTouchControls() {
+        ViewGroup decor = (ViewGroup) getWindow().getDecorView();
+        if (controlsOverlay != null && controlsOverlay.getParent() instanceof ViewGroup) {
+            ((ViewGroup) controlsOverlay.getParent()).removeView(controlsOverlay);
+        }
+        FrameLayout controls = new FrameLayout(this);
+        controls.setFocusable(false);
+
+        GridLayout dpad = new GridLayout(this);
+        dpad.setRowCount(3);
+        dpad.setColumnCount(3);
+        addDpadButton(dpad, "↑", KeyEvent.KEYCODE_DPAD_UP, 1, 0);
+        addDpadButton(dpad, "←", KeyEvent.KEYCODE_DPAD_LEFT, 0, 1);
+        addDpadButton(dpad, "→", KeyEvent.KEYCODE_DPAD_RIGHT, 2, 1);
+        addDpadButton(dpad, "↓", KeyEvent.KEYCODE_DPAD_DOWN, 1, 2);
+
+        FrameLayout.LayoutParams dpadParams = new FrameLayout.LayoutParams(dp(168), dp(168), Gravity.START | Gravity.BOTTOM);
+        dpadParams.setMargins(dp(18), 0, 0, dp(20));
+        controls.addView(dpad, dpadParams);
+
+        LinearLayout faceButtons = new LinearLayout(this);
+        faceButtons.setOrientation(LinearLayout.VERTICAL);
+        faceButtons.setGravity(Gravity.CENTER);
+
+        LinearLayout topRow = new LinearLayout(this);
+        topRow.addView(makeControl("L", KeyEvent.KEYCODE_Q, dp(56)));
+        topRow.addView(makeControl("R", KeyEvent.KEYCODE_W, dp(56)));
+        faceButtons.addView(topRow);
+
+        LinearLayout actionRow = new LinearLayout(this);
+        actionRow.addView(makeControl("B", KeyEvent.KEYCODE_X, dp(68)));
+        actionRow.addView(makeControl("A", KeyEvent.KEYCODE_Z, dp(68)));
+        faceButtons.addView(actionRow);
+
+        LinearLayout menuRow = new LinearLayout(this);
+        menuRow.addView(makeControl("Map", KeyEvent.KEYCODE_SPACE, dp(56)));
+        menuRow.addView(makeControl("Start", KeyEvent.KEYCODE_ENTER, dp(56)));
+        faceButtons.addView(menuRow);
+
+        FrameLayout.LayoutParams faceParams = new FrameLayout.LayoutParams(-2, -2, Gravity.END | Gravity.BOTTOM);
+        faceParams.setMargins(0, 0, dp(18), dp(16));
+        controls.addView(faceButtons, faceParams);
+
+        controlsOverlay = controls;
+        decor.addView(controlsOverlay, new ViewGroup.LayoutParams(-1, -1));
+    }
+
+    private void addDpadButton(GridLayout grid, String label, int keyCode, int column, int row) {
+        TextView button = makeControl(label, keyCode, dp(54));
+        GridLayout.LayoutParams params = new GridLayout.LayoutParams(
+                GridLayout.spec(row), GridLayout.spec(column));
+        params.width = dp(54);
+        params.height = dp(54);
+        params.setMargins(dp(1), dp(1), dp(1), dp(1));
+        grid.addView(button, params);
+    }
+
+    private TextView makeControl(String label, int keyCode, int size) {
+        TextView button = new TextView(this);
+        button.setText(label);
+        button.setTextColor(Color.WHITE);
+        button.setTextSize(label.length() > 1 ? 13 : 22);
+        button.setGravity(Gravity.CENTER);
+        button.setFocusable(false);
+        button.setBackground(background(false));
+        button.setOnTouchListener((view, event) -> {
+            int action = event.getActionMasked();
+            if (action == MotionEvent.ACTION_DOWN || action == MotionEvent.ACTION_POINTER_DOWN) {
+                if (!heldControls.containsKey(view)) {
+                    heldControls.put(view, keyCode);
+                    sendKey(keyCode, KeyEvent.ACTION_DOWN);
+                    view.setBackground(background(true));
+                }
+                return true;
+            }
+            if (action == MotionEvent.ACTION_UP || action == MotionEvent.ACTION_CANCEL || action == MotionEvent.ACTION_POINTER_UP) {
+                releaseControl(view);
+                return true;
+            }
+            return true;
+        });
+
+        // Size is supplied by the parent for the d-pad. Face buttons use a
+        // comfortably tappable square with a small gap between controls.
+        LinearLayout.LayoutParams params = new LinearLayout.LayoutParams(size, size);
+        params.setMargins(dp(3), dp(3), dp(3), dp(3));
+        button.setLayoutParams(params);
+        return button;
+    }
+
+    private GradientDrawable background(boolean pressed) {
+        GradientDrawable shape = new GradientDrawable();
+        shape.setShape(GradientDrawable.OVAL);
+        shape.setColor(pressed ? Color.argb(190, 50, 120, 210) : Color.argb(120, 20, 24, 32));
+        shape.setStroke(dp(1), Color.argb(170, 255, 255, 255));
+        return shape;
+    }
+
+    private void sendKey(int keyCode, int action) {
+        long now = System.currentTimeMillis();
+        dispatchKeyEvent(new KeyEvent(now, now, action, keyCode, 0));
+    }
+
+    private void releaseControl(View view) {
+        Integer keyCode = heldControls.remove(view);
+        if (keyCode != null) {
+            sendKey(keyCode, KeyEvent.ACTION_UP);
+            view.setBackground(background(false));
+        }
+    }
+
+    private int dp(int value) {
+        return Math.round(value * getResources().getDisplayMetrics().density);
+    }
+
+    @Override
+    public void onPause() {
+        for (View view : new java.util.ArrayList<>(heldControls.keySet())) releaseControl(view);
+        super.onPause();
+    }
+}
diff --git 1/android/app/src/main/java/org/zquestclassic/android/MainActivity.java 2/android/app/src/main/java/org/zquestclassic/android/MainActivity.java
new file mode 100644
index 0000000..bf52a3f
--- /dev/null
+++ 2/android/app/src/main/java/org/zquestclassic/android/MainActivity.java
@@ -0,0 +1,294 @@
+package org.zquestclassic.android;
+
+import android.app.Activity;
+import android.content.Intent;
+import android.database.Cursor;
+import android.net.Uri;
+import android.os.Bundle;
+import android.provider.OpenableColumns;
+import android.view.Gravity;
+import android.view.View;
+import android.widget.Button;
+import android.widget.LinearLayout;
+import android.widget.ProgressBar;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import org.liballeg.android.PlayerActivity;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.nio.charset.StandardCharsets;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.zip.ZipEntry;
+import java.util.zip.ZipInputStream;
+
+/** Lets the user select a .qst or a .zip containing a quest. */
+public final class MainActivity extends Activity {
+    private static final int REQUEST_QUEST = 1;
+    private static final long MAX_QUEST_BYTES = 1024L * 1024L * 1024L;
+
+    private final ExecutorService importer = Executors.newSingleThreadExecutor();
+    private Button chooseButton;
+    private ProgressBar progress;
+    private TextView status;
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        showPickerScreen();
+
+        Uri incoming = getIntent() == null ? null : getIntent().getData();
+        if (incoming != null) {
+            importQuest(incoming);
+        }
+    }
+
+    private void showPickerScreen() {
+        LinearLayout content = new LinearLayout(this);
+        content.setOrientation(LinearLayout.VERTICAL);
+        content.setGravity(Gravity.CENTER);
+        int padding = dp(28);
+        content.setPadding(padding, padding, padding, padding);
+
+        TextView title = new TextView(this);
+        title.setText("ZQuest Classic");
+        title.setTextSize(28);
+        title.setGravity(Gravity.CENTER);
+        content.addView(title, new LinearLayout.LayoutParams(-1, -2));
+
+        TextView instructions = new TextView(this);
+        instructions.setText("Choose a quest file (.qst) or a quest download (.zip).\nThe quest will be imported into this device for offline play.");
+        instructions.setTextSize(16);
+        instructions.setGravity(Gravity.CENTER);
+        LinearLayout.LayoutParams messageParams = new LinearLayout.LayoutParams(-1, -2);
+        messageParams.topMargin = dp(16);
+        content.addView(instructions, messageParams);
+
+        chooseButton = new Button(this);
+        chooseButton.setText("Choose quest file");
+        chooseButton.setOnClickListener(view -> openDocumentPicker());
+        LinearLayout.LayoutParams buttonParams = new LinearLayout.LayoutParams(-2, -2);
+        buttonParams.topMargin = dp(24);
+        content.addView(chooseButton, buttonParams);
+
+        progress = new ProgressBar(this);
+        progress.setVisibility(View.GONE);
+        LinearLayout.LayoutParams progressParams = new LinearLayout.LayoutParams(-2, -2);
+        progressParams.topMargin = dp(12);
+        content.addView(progress, progressParams);
+
+        status = new TextView(this);
+        status.setGravity(Gravity.CENTER);
+        LinearLayout.LayoutParams statusParams = new LinearLayout.LayoutParams(-1, -2);
+        statusParams.topMargin = dp(12);
+        content.addView(status, statusParams);
+
+        setContentView(content);
+    }
+
+    private void openDocumentPicker() {
+        Intent picker = new Intent(Intent.ACTION_OPEN_DOCUMENT);
+        picker.addCategory(Intent.CATEGORY_OPENABLE);
+        picker.setType("*/*");
+        startActivityForResult(picker, REQUEST_QUEST);
+    }
+
+    @Override
+    protected void onActivityResult(int requestCode, int resultCode, Intent data) {
+        super.onActivityResult(requestCode, resultCode, data);
+        if (requestCode == REQUEST_QUEST && resultCode == RESULT_OK && data != null && data.getData() != null) {
+            importQuest(data.getData());
+        }
+    }
+
+    private void importQuest(Uri uri) {
+        chooseButton.setEnabled(false);
+        progress.setVisibility(View.VISIBLE);
+        status.setText("Importing quest…");
+
+        importer.execute(() -> {
+            try {
+                String name = displayName(uri);
+                String lowerName = name.toLowerCase(java.util.Locale.ROOT);
+                copyResourcesIfNeeded();
+                File quests = new File(getFilesDir(), "quests");
+                if (!quests.isDirectory() && !quests.mkdirs()) {
+                    throw new IllegalStateException("Could not create the quest folder.");
+                }
+
+                File selectedQuest;
+                if (lowerName.endsWith(".qst")) {
+                    selectedQuest = new File(quests, safeBaseName(name));
+                    try (InputStream input = getContentResolver().openInputStream(uri)) {
+                        if (input == null) throw new IllegalStateException("Could not open the selected file.");
+                        copyLimited(input, new FileOutputStream(selectedQuest));
+                    }
+                } else if (lowerName.endsWith(".zip")) {
+                    selectedQuest = importQuestArchive(uri, quests, name);
+                } else {
+                    throw new IllegalArgumentException("Select a .qst file or a .zip containing a .qst file.");
+                }
+
+                File marker = new File(getFilesDir(), "selected-quest.txt");
+                try (FileOutputStream output = new FileOutputStream(marker)) {
+                    output.write(selectedQuest.getAbsolutePath().getBytes(StandardCharsets.UTF_8));
+                    output.write('\n');
+                }
+
+                runOnUiThread(() -> {
+                    progress.setVisibility(View.GONE);
+                    chooseButton.setEnabled(true);
+                    status.setText("Starting " + selectedQuest.getName());
+                    startActivity(new Intent(this, PlayerActivity.class));
+                });
+            } catch (Exception error) {
+                runOnUiThread(() -> {
+                    progress.setVisibility(View.GONE);
+                    chooseButton.setEnabled(true);
+                    status.setText(error.getMessage() == null ? "Could not import this quest." : error.getMessage());
+                    Toast.makeText(this, status.getText(), Toast.LENGTH_LONG).show();
+                });
+            }
+        });
+    }
+
+    private File importQuestArchive(Uri uri, File destination, String archiveName) throws Exception {
+        String folderName = safeFileComponent(archiveName.replaceFirst("(?i)\\.zip$", ""));
+        File questFolder = new File(destination, folderName);
+        for (int suffix = 2; questFolder.exists(); suffix++) {
+            questFolder = new File(destination, folderName + " (" + suffix + ")");
+        }
+        if (!questFolder.mkdirs()) throw new IllegalStateException("Could not create the quest folder.");
+
+        try (InputStream source = getContentResolver().openInputStream(uri)) {
+            if (source == null) throw new IllegalStateException("Could not open the selected ZIP file.");
+            try (ZipInputStream zip = new ZipInputStream(source)) {
+                File selectedQuest = null;
+                long totalBytes = 0;
+                ZipEntry entry;
+                while ((entry = zip.getNextEntry()) != null) {
+                    File output = resolveArchiveEntry(questFolder, entry.getName());
+                    if (entry.isDirectory()) {
+                        if (!output.isDirectory() && !output.mkdirs()) {
+                            throw new IllegalStateException("Could not create a folder from the quest archive.");
+                        }
+                    } else {
+                        File parent = output.getParentFile();
+                        if (parent != null && !parent.isDirectory() && !parent.mkdirs()) {
+                            throw new IllegalStateException("Could not create a folder from the quest archive.");
+                        }
+                        totalBytes += copyLimited(zip, new FileOutputStream(output), MAX_QUEST_BYTES - totalBytes);
+                        if (selectedQuest == null && output.getName().toLowerCase(java.util.Locale.ROOT).endsWith(".qst")) {
+                            selectedQuest = output;
+                        }
+                    }
+                    zip.closeEntry();
+                }
+                if (selectedQuest != null) return selectedQuest;
+            }
+        }
+        throw new IllegalArgumentException("The ZIP archive does not contain a .qst quest file.");
+    }
+
+    private void copyResourcesIfNeeded() throws Exception {
+        File marker = new File(getFilesDir(), ".resources-installed-v2");
+        if (marker.isFile()) return;
+
+        copyAssetTree("", getFilesDir());
+        if (!marker.createNewFile() && !marker.isFile()) {
+            throw new IllegalStateException("Could not finish installing game resources.");
+        }
+    }
+
+    private void copyAssetTree(String assetPath, File destination) throws Exception {
+        String[] children = getAssets().list(assetPath);
+        if (children != null && children.length > 0) {
+            if (!destination.isDirectory() && !destination.mkdirs()) {
+                throw new IllegalStateException("Could not create the game resources folder.");
+            }
+            for (String child : children) {
+                String childPath = assetPath.isEmpty() ? child : assetPath + "/" + child;
+                copyAssetTree(childPath, new File(destination, child));
+            }
+            return;
+        }
+
+        File parent = destination.getParentFile();
+        if (parent != null && !parent.isDirectory() && !parent.mkdirs()) {
+            throw new IllegalStateException("Could not create a resources folder.");
+        }
+        try (InputStream input = getAssets().open(assetPath)) {
+            copyLimited(input, new FileOutputStream(destination));
+        }
+    }
+
+    private String displayName(Uri uri) {
+        try (Cursor cursor = getContentResolver().query(uri, null, null, null, null)) {
+            if (cursor != null && cursor.moveToFirst()) {
+                int index = cursor.getColumnIndex(OpenableColumns.DISPLAY_NAME);
+                if (index >= 0) return cursor.getString(index);
+            }
+        }
+        String path = uri.getLastPathSegment();
+        return path == null ? "quest.qst" : path;
+    }
+
+    private static String safeBaseName(String name) {
+        String base = safeFileComponent(name);
+        if (!base.toLowerCase(java.util.Locale.ROOT).endsWith(".qst")) base += ".qst";
+        return base;
+    }
+
+    private static String safeFileComponent(String name) {
+        String base = new File(name).getName().replaceAll("[^A-Za-z0-9._ -]", "_").trim();
+        if (base.isEmpty() || base.equals(".") || base.equals("..")) return "quest";
+        return base;
+    }
+
+    private static void copyLimited(InputStream input, OutputStream output) throws Exception {
+        copyLimited(input, output, MAX_QUEST_BYTES);
+    }
+
+    private static File resolveArchiveEntry(File root, String entryName) throws Exception {
+        String normalizedName = entryName.replace('\\', '/');
+        if (normalizedName.startsWith("/") || normalizedName.matches("^[A-Za-z]:.*")) {
+            throw new IllegalArgumentException("The ZIP archive contains an unsafe path.");
+        }
+        if (normalizedName.isEmpty() || normalizedName.equals(".") || normalizedName.equals("./")) return root;
+        File output = new File(root, normalizedName);
+        String rootPath = root.getCanonicalPath() + File.separator;
+        String outputPath = output.getCanonicalPath();
+        if (!outputPath.startsWith(rootPath)) {
+            throw new IllegalArgumentException("The ZIP archive contains an unsafe path.");
+        }
+        return output;
+    }
+
+    private static long copyLimited(InputStream input, OutputStream output, long maxBytes) throws Exception {
+        try (OutputStream destination = output) {
+            byte[] buffer = new byte[64 * 1024];
+            long total = 0;
+            int count;
+            while ((count = input.read(buffer)) != -1) {
+                total += count;
+                if (total > maxBytes) throw new IllegalArgumentException("The quest archive is too large (1 GiB limit).");
+                destination.write(buffer, 0, count);
+            }
+            return total;
+        }
+    }
+
+    private int dp(int value) {
+        return Math.round(value * getResources().getDisplayMetrics().density);
+    }
+
+    @Override
+    protected void onDestroy() {
+        importer.shutdownNow();
+        super.onDestroy();
+    }
+}
