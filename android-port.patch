diff --git 1/android/README.md 2/android/README.md
new file mode 100644
index 0000000..6842f3e
--- /dev/null
+++ 2/android/README.md
@@ -0,0 +1,43 @@
+# ZQuest Classic for Android (player)
+
+This is a native Android player using the project's C++ runtime and Allegro's
+Android backend. It does not include the desktop quest editor.
+
+## Build
+
+Install Android Studio with the Android SDK, NDK, and CMake 3.27 or newer. The
+build also needs a Java 17 runtime and Gradle 8.9 or newer on `PATH`.
+
+```sh
+export ANDROID_HOME="$HOME/Android/Sdk" # adjust if needed
+export ANDROID_NDK_HOME="$ANDROID_HOME/ndk/<installed-version>" # optional
+./android/build.sh
+```
+
+The debug APK is written to
+`android/app/build/outputs/apk/debug/app-debug.apk`. The script first generates
+Allegro's Android library; run it once before opening `android/` in Android
+Studio so that its local AAR dependency is available.
+
+## Playing a quest
+
+Launch the app and choose either a `.qst` file or a `.zip` containing a `.qst`
+file. For ZIPs, the first `.qst` entry is selected and companion files are
+extracted into that quest's private folder. The quest and save files are copied into the app's private
+storage, so the game can run offline and does not need broad storage
+permissions.
+
+The player starts directly in the selected quest. The on-screen D-pad and
+buttons send the same key events as a keyboard. Hardware keyboards are handled
+by Allegro; the default ZC controls are the arrow keys, `Z`/`X`, `Q`/`W`,
+`Enter`, and `Space`.
+
+## Current limitations
+
+- The APK includes `arm64-v8a` for phones and `x86_64` for Waydroid and other
+  x86-64 Android environments.
+- ZIP archives must contain an unencrypted `.qst` file. The first `.qst` is
+  selected; the archive's companion files are extracted beside it.
+- The debug APK builds successfully, but has not yet been installed or run on
+  an Android device. Quest compatibility and touch/keyboard behavior still
+  need device testing.
diff --git 1/android/app/build.gradle 2/android/app/build.gradle
new file mode 100644
index 0000000..64a93c7
--- /dev/null
+++ 2/android/app/build.gradle
@@ -0,0 +1,61 @@
+plugins {
+    id "com.android.application"
+}
+
+android {
+    namespace "org.zquestclassic.android"
+    compileSdk 35
+    ndkVersion "26.3.11579264"
+
+    defaultConfig {
+        applicationId "org.zquestclassic.android"
+        minSdk 23
+        targetSdk 35
+        versionCode 1
+        versionName "3.0.0-dev"
+
+        ndk {
+            abiFilters "arm64-v8a", "x86_64"
+        }
+
+        externalNativeBuild {
+            cmake {
+                targets "zplayer"
+                arguments "-DANDROID_STL=c++_shared",
+                          "-DWANT_NFD=OFF",
+                          "-DWANT_ZUPDATER=OFF",
+                          "-DWANT_WEBSOCKETS=OFF",
+                          "-DWANT_ZC_TESTS=OFF"
+            }
+        }
+    }
+
+    sourceSets {
+        main {
+            // The runtime expects its standard resources directory beside its
+            // config and save files. MainActivity copies these assets into the
+            // app's private files directory on first launch.
+            assets.srcDirs = ["../../resources"]
+        }
+    }
+
+    externalNativeBuild {
+        cmake {
+            path file("../../CMakeLists.txt")
+            version "3.30.5"
+        }
+    }
+
+    buildTypes {
+        debug {
+            minifyEnabled false
+        }
+        release {
+            minifyEnabled false
+        }
+    }
+}
+
+dependencies {
+    implementation files("libs/allegro-release.aar")
+}
